# xchain-encoder configuration. Copy to .env and fill in values.
# Full description of every variable lives in README.md ("Configuration").

# Required: coin and network (e.g. bitcoin-mainnet, bitcoin-regtest,
# litecoin-testnet, dogecoin-mainnet).
NETWORK=bitcoin-regtest

# Required: coin node RPC connection.
NODE_URL=127.0.0.1
NODE_PORT=8332
NODE_USER=rpcuser
NODE_PASSWORD=rpcpass

# Optional: JSON-RPC API port the encoder listens on (default 3003).
ENCODER_API_PORT=3003

# Optional: xchain-utxo-tracker service location. Without these, the encoder
# falls back to fetching UTXOs from the coin node directly.
UTXO_TRACKER_URL=127.0.0.1
UTXO_TRACKER_API_PORT=3001

# Optional: cap fee-rate estimates at this sat/kB ceiling.
# MAX_FEE_RATE_KB=200000

# Optional: API hardening for shared deployments.
# API_KEY=
# ENCODER_RATE_LIMIT_RPM=60
# CORS_ORIGIN=*
